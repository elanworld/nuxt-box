FROM node:22-bookworm-slim AS build
WORKDIR /app
RUN apt-get update && apt-get install -y python3 make g++ && rm -rf /var/lib/apt/lists/*
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
ENV NUXT_APP_BASE_URL=/task-library/
RUN npm run build:cloudflare-d1

FROM node:22-bookworm-slim
WORKDIR /app
ENV NUXT_APP_BASE_URL=/task-library/
ENV TASK_LIBRARY_RUNTIME=cloudflare
ENV WRANGLER_PERSIST_DIR=/data/wrangler
RUN npm install -g wrangler@4.22.0
COPY --from=build /app/.output ./.output
COPY --from=build /app/drizzle ./drizzle
COPY wrangler.docker.toml ./wrangler.toml
COPY scripts/worker-sqlite-entry.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh && mkdir -p /data/wrangler
VOLUME ["/data"]
EXPOSE 8787
CMD ["/entrypoint.sh"]